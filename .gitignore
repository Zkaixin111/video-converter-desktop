# ── 依赖 ──────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── 构建与打包产物 ────────────────────────────────────
dist/
out/
release/
build/
*.tsbuildinfo
*.log
npm-debug.log*

# ── 随包分发的转换引擎二进制 ──────────────────────────
# 体积大且涉及 GPL 合规，走单独的分发流程，不入代码仓库
resources/bin/
vendor/
*.exe
*.dll
*.dylib

# ── 测试样本（由 scripts/make-fixtures.ps1 生成）──────
tests/fixtures/

# ── 本地环境与密钥 ────────────────────────────────────
.env
.env.*
!.env.example
*.local
*.pem
*.key

# ── 编辑器与系统 ──────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ── 智能体工作区（本地会话数据与日志，不随仓库分发）──
.workbuddy/
