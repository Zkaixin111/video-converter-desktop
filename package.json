{
  "name": "video-converter-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "本地视频格式转换桌面客户端（Electron + React + TypeScript + FFmpeg）",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:int": "vitest run tests/integration",
    "test:all": "vitest run",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-store": "12.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-electron": "1.1.2",
    "vite-plugin-electron-renderer": "1.0.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
